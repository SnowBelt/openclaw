{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pattern Lab World-Class Thumbnail Brief",
  "type": "object",
  "required": [
    "video_id", "city", "viewer_promise", "hidden_history_question",
    "proof_object", "city_anchor", "emotion", "hero_subject",
    "headline_options", "color_direction", "source_asset_ids",
    "forbidden_claims", "first_30_second_payoff", "ai_support_policy"
  ],
  "properties": {
    "video_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 2},
    "viewer_promise": {"type": "string", "minLength": 12},
    "hidden_history_question": {"type": "string", "minLength": 12},
    "proof_object": {"type": "string", "minLength": 3},
    "city_anchor": {"type": "string", "minLength": 3},
    "emotion": {"type": "string", "minLength": 3},
    "hero_subject": {"type": "string", "minLength": 3},
    "presenter_role": {"type": ["string", "null"]},
    "headline_options": {
      "type": "array", "minItems": 3, "maxItems": 8,
      "items": {"type": "string", "minLength": 2}
    },
    "color_direction": {"type": "string", "minLength": 3},
    "source_asset_ids": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_claims": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "first_30_second_payoff": {"type": "string", "minLength": 12},
    "ai_support_policy": {"enum": ["none", "non_proof_support_only"]}
  },
  "additionalProperties": true
}
