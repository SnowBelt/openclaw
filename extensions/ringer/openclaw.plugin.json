{
  "id": "ringer",
  "name": "Local AI Assist",
  "description": "Proof-gated local agent swarms controlled by Codex through an exact-pinned Ringer adapter.",
  "activation": {
    "onStartup": true
  },
  "commandAliases": [
    {
      "name": "ringer"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "productionEnabled": {
        "type": "boolean"
      },
      "ringerSourceDir": {
        "type": "string"
      },
      "expectedRingerCommit": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "expectedRingerSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "ringerConfigPath": {
        "type": "string"
      },
      "expectedRingerConfigSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "openclawCliPath": {
        "type": "string"
      },
      "ollamaBaseUrl": {
        "type": "string",
        "pattern": "^http://(?:127\\.0\\.0\\.1|localhost)(?::[0-9]+)?$"
      },
      "dockerHost": {
        "type": "string",
        "pattern": "^unix:///.+"
      },
      "dockerImage": {
        "type": "string",
        "minLength": 1
      },
      "expectedDockerImageSha256": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "expectedOpenclawCliSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "expectedOpenclawVersion": {
        "type": "string",
        "minLength": 1
      },
      "expectedWorkerSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "expectedVerifierSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "qualificationReceiptPath": {
        "type": "string"
      },
      "expectedQualificationReceiptSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "expectedPolicySha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "stateDir": {
        "type": "string"
      },
      "callerSecret": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "provider",
          "id"
        ],
        "properties": {
          "source": {
            "const": "file"
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxParallel": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2
      },
      "maxTasks": {
        "type": "integer",
        "minimum": 2,
        "maximum": 8
      },
      "maxPatchBytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 20971520
      },
      "maxSnapshotBytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 536870912
      },
      "maxSnapshotStorageBytes": {
        "type": "integer",
        "minimum": 268435456,
        "maximum": 137438953472
      },
      "rawRetentionDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30
      },
      "receiptRetentionDays": {
        "type": "integer",
        "minimum": 7,
        "maximum": 365
      },
      "minFreeMemoryBytesForTwoWorkers": {
        "type": "integer",
        "minimum": 1073741824
      },
      "allowedRepositories": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "checkArgvPrefixes",
            "models"
          ],
          "properties": {
            "root": {
              "type": "string"
            },
            "checkArgvPrefixes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "models": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "contextWindow",
                  "maxTokens",
                  "roles",
                  "canaryApproved"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "pattern": "^ollama/[^/]+$"
                  },
                  "contextWindow": {
                    "type": "integer",
                    "minimum": 4096,
                    "maximum": 262144
                  },
                  "maxTokens": {
                    "type": "integer",
                    "minimum": 512,
                    "maximum": 65536
                  },
                  "roles": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "code",
                        "clerical",
                        "analysis",
                        "critic"
                      ]
                    }
                  },
                  "canaryApproved": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "uiHints": {
    "enabled": {
      "label": "Enable Local AI Assist",
      "help": "Load the exact-pinned Ringer control plane. Production starts remain separately gated."
    },
    "productionEnabled": {
      "label": "Enable Qualified Starts",
      "help": "Allow start only after model qualification and live canary evidence are current."
    },
    "callerSecret": {
      "label": "Codex Caller Secret",
      "help": "File-backed SecretRef used to authenticate Codex-only mutation requests.",
      "sensitive": true
    },
    "ollamaBaseUrl": {
      "label": "Loopback Ollama URL",
      "help": "Only a loopback HTTP Ollama endpoint is accepted by the local worker."
    },
    "dockerHost": {
      "label": "Docker Unix Socket",
      "help": "Exact unix:/// socket URL used by the isolated worker; TCP Docker endpoints are rejected."
    },
    "dockerImage": {
      "label": "Sandbox Image",
      "help": "Preinstalled Docker image used for code-writing worker isolation."
    },
    "expectedDockerImageSha256": {
      "label": "Sandbox Image Digest",
      "help": "Exact immutable Docker image ID required before any worker starts."
    },
    "qualificationReceiptPath": {
      "label": "Qualification Receipt",
      "help": "Digest-pinned report proving the matched-corpus and live-canary promotion gates."
    }
  }
}
