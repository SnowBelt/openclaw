<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.openclaw.custom-runtime.guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/openclaw/.openclaw-custom-runtime/bin/custom-runtime-guard.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/Users/openclaw/Library/Logs/openclaw/custom-runtime-guard.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/openclaw/Library/Logs/openclaw/custom-runtime-guard-error.log</string>
</dict>
</plist>
