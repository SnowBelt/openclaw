    "restart": ["local_tests", "source_typecheck", "test_typecheck", "policy_checks", "capability_checks", "immutable_candidate", "rollback_ready", "browser_desktop", "browser_mobile", "gateway_health"],
    "rollback": ["local_tests", "source_typecheck", "test_typecheck", "policy_checks", "capability_checks", "rollback_ready", "rollback_health"],
    "finalize": ["local_tests", "source_typecheck", "test_typecheck", "policy_checks", "capability_checks", "immutable_candidate", "rollback_ready", "browser_desktop", "browser_mobile", "gateway_health", "ledger_receipt"]
  },
  "proofProfiles": {
    "mac_studio_control_director": {
      "version": 1,
      "project": "project-command-center",
      "destination": "local-only",
      "externalDisclosure": false,
      "prohibitedChecks": ["workflow_sanity", "remote_ci", "browser_mobile", "remote_device", "blacksmith", "testbox", "crabbox"],
      "requiredChecks": {
        "stage": ["local_tests", "source_typecheck", "test_typecheck", "policy_checks", "capability_checks", "immutable_candidate", "rollback_ready"],
        "promotion": ["local_tests", "source_typecheck", "test_typecheck", "policy_checks", "capability_checks", "immutable_candidate", "rollback_ready", "authenticated_local_control_director_pcc_browser", "gateway_health", "persistence", "restart_recovery", "owner_acceptance"],
        "restart": ["local_tests", "source_typecheck", "test_typecheck", "policy_checks", "capability_checks", "immutable_candidate", "rollback_ready", "authenticated_local_control_director_pcc_browser", "gateway_health"],
        "rollback": ["local_tests", "source_typecheck", "test_typecheck", "policy_checks", "capability_checks", "rollback_ready", "rollback_health"],
        "finalize": ["local_tests", "source_typecheck", "test_typecheck", "policy_checks", "capability_checks", "immutable_candidate", "rollback_ready", "authenticated_local_control_director_pcc_browser", "gateway_health", "persistence", "restart_recovery", "owner_acceptance", "ledger_receipt"]
      }
