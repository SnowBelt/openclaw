{
  "schema": "openclaw.release-governor-policy.v1",
  "version": 2,
  "confidenceThreshold": 0.9,
  "reviewConfidenceThreshold": 0.93,
  "classificationRules": [
    { "pattern": "docs/**", "category": "documentation", "risk": "P3" },
    { "pattern": "test/**", "category": "tests", "risk": "P3" },
    { "pattern": "src/pcc/**", "category": "pcc", "risk": "P2" },
    { "pattern": "src/agents/**", "category": "agent-runtime", "risk": "P2" },
    { "pattern": "src/gateway/**", "category": "gateway", "risk": "P2" },
    { "pattern": "packages/gateway-protocol/**", "category": "protocol", "risk": "P2" },
    { "pattern": "ui/**", "category": "control-ui", "risk": "P2" },
    { "pattern": "apps/shared/OpenClawKit/**", "category": "client-protocol", "risk": "P2" },
    { "pattern": "config/**", "category": "configuration", "risk": "P1" },
    { "pattern": "scripts/**", "category": "tooling", "risk": "P2" },
    { "pattern": "package.json", "category": "dependencies", "risk": "P1" },
    { "pattern": "pnpm-lock.yaml", "category": "dependencies", "risk": "P1" }
  ],
  "protectedPaths": [
    { "pattern": "src/pcc/release-governance/**", "reason": "Release Governor policy and evidence are protected." },
    { "pattern": "config/release-governor-policy.json", "reason": "Release policy is protected." },
    { "pattern": "config/custom-runtime-capabilities.json", "reason": "Runtime capability contract is protected." },
